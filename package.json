{
  "name": "dimaalena",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.config.admin.ts",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "dev:admin:all": "concurrently \"npm run dev:server\" \"npm run dev:admin\"",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b tsconfig.admin.json && vite build --config vite.config.admin.ts",
    "build:all": "npm run build && npm run build:admin",
    "deploy:admin": "node scripts/deploy-admin.mjs",
    "verify:admin": "node scripts/verify-deploy.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:admin": "vite preview --config vite.config.admin.ts",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
